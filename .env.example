# .env.example
# Copy this file to .env and fill in your actual values.
# Never commit .env to git. Add it to .gitignore.
# For Streamlit Cloud: add these under Settings → Secrets (TOML format).

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Solana Data ──────────────────────────────────────────────────────────────
HELIUS_API_KEY=
SOLSCAN_API_KEY=

# ── Pro Exchange APIs ─────────────────────────────────────────────────────────
# Leave empty if not using Pro Terminal features.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Notifications ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── App Config ────────────────────────────────────────────────────────────────
APP_PASSWORD=
APP_ENV=development
# APP_ENV options: development | staging | production

# ── Feature Flags (override defaults from core/constants.py) ──────────────────
# FEATURE_PRO_TERMINAL=false
# FEATURE_MEME_ALPHA=true
# FEATURE_TELEGRAM_ALERTS=false
