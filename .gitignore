.streamlit/secrets.toml
.env
data/*
# Keep committed sample/fixture event files; runtime journals (*.jsonl) stay ignored.
!data/gold_bot/
data/gold_bot/*
!data/gold_bot/*.sample.json
!data/gold_bot/*.manual.json
# LM84A generated historical market data — never commit (already covered by
# data/gold_bot/* ; listed explicitly for intent).
data/gold_bot/history/*.csv
data/gold_bot/history/*.json
# LM84B macro history: track README + samples/*.sample.csv; ignore imports.
!data/gold_bot/macro_history/
data/gold_bot/macro_history/*
!data/gold_bot/macro_history/README.md
!data/gold_bot/macro_history/samples/
data/gold_bot/macro_history/samples/*
!data/gold_bot/macro_history/samples/*.sample.csv
# LM85A generated replay output — never commit.
data/gold_bot/replay/*.jsonl
data/gold_bot/replay/*.json
data/gold_bot/replay/*.csv
# LM86A generated learning output — never commit.
data/gold_bot/learning/*.json
data/gold_bot/learning/*.jsonl
data/gold_bot/learning/*.csv
# LM86C automatic learning cycle output (already covered by data/gold_bot/* ;
# listed explicitly for intent) — never commit.
data/gold_bot/learning/cycles/*.json
data/gold_bot/learning/cycles/*.jsonl
data/gold_bot/learning/*.backup.json
data/gold_bot/learning/rejected_demo_modifiers.json
# LM87A demo safety supervisor state/events — never commit.
data/gold_bot/safety/*.json
data/gold_bot/safety/*.jsonl
data/gold_bot/safety/*.csv
# LM88A demo auto-session reports/events — never commit.
data/gold_bot/sessions/*.json
data/gold_bot/sessions/*.jsonl
data/gold_bot/sessions/*.csv
# LM89A trade outcome feedback files — never commit.
data/gold_bot/trade_outcomes/*.json
data/gold_bot/trade_outcomes/*.jsonl
data/gold_bot/trade_outcomes/*.csv
# LM89B real-trade learning blend outputs (already covered by data/gold_bot/* ;
# listed explicitly for intent) — never commit.
data/gold_bot/learning/real_trade_*.json
data/gold_bot/learning/real_trade_*.jsonl
data/gold_bot/learning/real_trade_*.csv
# LM90A session review digests — never commit.
data/gold_bot/reviews/*.md
data/gold_bot/reviews/*.json
data/gold_bot/reviews/*.jsonl
data/gold_bot/reviews/*.csv
# LM92A scheduled cycle run logs — never commit.
data/gold_bot/runs/*.json
data/gold_bot/runs/*.jsonl
data/gold_bot/runs/*.csv
# LM92B first-run preflight reports — never commit.
data/gold_bot/preflight/*.json
data/gold_bot/preflight/*.jsonl
data/gold_bot/preflight/*.csv
# LM94A local command gateway run logs — never commit.
data/gold_bot/commands/*.json
data/gold_bot/commands/*.jsonl
data/gold_bot/commands/*.csv
# LM96A Windows scheduled-task transcripts/logs — never commit.
data/gold_bot/task_logs/*.log
data/gold_bot/task_logs/*.txt
data/gold_bot/task_logs/*.json
data/gold_bot/task_logs/*.jsonl
# LM98A replay/backtest heartbeat artifacts — never commit.
data/gold_bot/replay_heartbeat/*.json
data/gold_bot/replay_heartbeat/*.jsonl
data/gold_bot/replay_heartbeat/*.md
__pycache__/
*.pyc
.DS_Store
# Local generated heatmap/live payloads
lumora-web/fixtures/heatmap/*.json
lumora-web/fixtures/live/*.json
lumora-web/fixtures/live/*.tmp
.agents/
.claude/
skills-lock.json
