# Copy to .env.local and fill in. .env.local is gitignored.

# Public origin — used for canonical / OG / sitemap / robots URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Discord invite for the landing CTAs.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite

# Google Analytics 4 measurement id ("G-XXXXXXXXXX"). Optional: leave unset and
# no analytics script loads at all. When set, GA only loads AFTER a visitor
# accepts the consent banner. Get it at analytics.google.com → Admin → Data
# streams → your web stream.
NEXT_PUBLIC_GA_ID=

# Supabase — waitlist email capture. The publishable (anon) key is public-safe;
# the waitlist table is insert-only via RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-side reads of the market-data tables (heatmap, whale_events).
# Use the anon key (tables have an anon read policy) OR a service_role key to
# keep them private. Set SUPABASE_SERVICE_ROLE_KEY instead of ANON to lock down.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...your-anon-jwt
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-jwt

# Gold-bot command route can exec local Python. It is hard-disabled (404) in
# production unless this is exactly "true". Leave unset/false on any public deploy.
LUMORA_ENABLE_GOLD_BOT_COMMANDS=false

# Secret that signs the invite-code access cookie (the app-route gate).
# Use a long random value; rotating it logs everyone out.
LUMORA_ACCESS_SECRET=change-me-to-a-long-random-string

# Owner master code — a private "skeleton key" invite code. Typed at /enter like
# any invite code, but checked server-side BEFORE the database, so the owner can
# always get in (even while the invite DB is down). Keep it secret; must be >=12
# chars to be active. Never commit a real value. Disabled when unset.
# Also unlocks the owner console at /admin (waitlist + send invite codes).
LUMORA_OWNER_CODE=

# Email (Resend) — owner notifications on new signups + invite-code delivery.
# Optional: leave RESEND_API_KEY unset and no email is sent (the /admin page
# still mints and shows the code for manual sending). Get a key at resend.com →
# API Keys. Verify your sending domain there for inbox deliverability.
RESEND_API_KEY=
# From address. Use a verified-domain sender for deliverability, e.g.
# "Lumora <invite@lumora-app.app>". Falls back to Resend's shared test sender.
RESEND_FROM=Lumora <onboarding@resend.dev>
# Where new-signup notifications are sent.
LUMORA_NOTIFY_EMAIL=legal.lumora@gmail.com
