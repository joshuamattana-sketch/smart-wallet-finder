# Copy to .env.local and fill in. .env.local is gitignored.

# Public origin — used for canonical / OG / sitemap / robots URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Discord invite for the landing CTAs.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite

# Supabase — waitlist email capture. The publishable (anon) key is public-safe;
# the waitlist table is insert-only via RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-side reads of the market-data tables (heatmap, whale_events).
# Use the anon key (tables have an anon read policy) OR a service_role key to
# keep them private. Set SUPABASE_SERVICE_ROLE_KEY instead of ANON to lock down.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...your-anon-jwt
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-jwt

# Gold-bot command route can exec local Python. It is hard-disabled (404) in
# production unless this is exactly "true". Leave unset/false on any public deploy.
LUMORA_ENABLE_GOLD_BOT_COMMANDS=false

# Secret that signs the invite-code access cookie (the app-route gate).
# Use a long random value; rotating it logs everyone out.
LUMORA_ACCESS_SECRET=change-me-to-a-long-random-string
